#!/bin/bash
#
# BSPWM startup script with improved structure and logging
#

###############################################################################
# CONFIGURATION
###############################################################################
LOG_DIR="$HOME/bin/logs"
OUTPUT_LOG="$LOG_DIR/bspwm_output.log"
ERROR_LOG="$LOG_DIR/bspwm_error.log"
DEBUG=false   # Set to true to enable set -x tracing

PRIMARY_WALLPAPER="$HOME/bin/wallpaper.jpg"
INTERNAL_MONITOR="eDP-1"

###############################################################################
# UTILITY FUNCTIONS
###############################################################################

log() { printf "[%s] %s\n" "$(date '+%F %T')" "$*" | tee -a "$OUTPUT_LOG"; }

restart_app() {
    local app="$1"
    shift
    pkill -x "$app" 2>/dev/null
    # Give it ~2s to exit, then force it so startup never hangs
    for _ in $(seq 20); do pgrep -x "$app" >/dev/null || break; sleep 0.1; done
    pkill -9 -x "$app" 2>/dev/null
    "$app" "$@" &
    log "Restarted: $app $*"
}

start_app() {
    local app="$1"
    shift
    if ! pgrep -x "$app" >/dev/null; then
        "$app" "$@" &
        log "Started: $app $*"
    fi
}

###############################################################################
# SETUP FUNCTIONS
###############################################################################

# Move desktops "$@" to monitor $1 (creating missing ones); windows go with them
place_desktops() {
    local mon="$1" d
    shift
    for d in "$@"; do
        if bspc query -D -d "$d" >/dev/null 2>&1; then
            bspc desktop "$d" -m "$mon" 2>/dev/null   # fails harmlessly if already there
        else
            bspc monitor "$mon" -a "$d"
        fi
    done
}

# Idempotent: runs at startup and on every hotplug/KVM switch
setup_monitors() {
    local ext o

    # Turn off outputs that are gone but still active, and wait for bspwm to drop them
    for o in $(xrandr | awk '/ disconnected (primary )?[0-9]/ {print $1}'); do
        xrandr --output "$o" --off
        for _ in $(seq 20); do bspc query -M -m "$o" >/dev/null 2>&1 || break; sleep 0.1; done
    done

    # First connected output that isn't the laptop panel (name varies: HDMI-1, HDMI-2-1, DP-1...)
    ext="$(xrandr | awk -v i="$INTERNAL_MONITOR" '/ connected/ && $1 != i {print $1; exit}')"

    if [ -n "$ext" ]; then
        # Enable output first; bspwm only knows active monitors, and adds them asynchronously
        xrandr --output "$INTERNAL_MONITOR" --auto --output "$ext" --auto --primary --left-of "$INTERNAL_MONITOR"
        for _ in $(seq 20); do bspc query -M -m "$ext" >/dev/null 2>&1 && break; sleep 0.1; done
        # Internal first, so desktop index matches name (^1="1" ... ^8="8") docked or not
        bspc wm --reorder-monitors "$INTERNAL_MONITOR" "$ext"
        dunstify -a "BSPWM" "INFO" "External monitor detected: $ext" -r 5551
        place_desktops "$ext" 5 6 7 8
        place_desktops "$INTERNAL_MONITOR" 1 2 3 4

    else
        xrandr --output "$INTERNAL_MONITOR" --auto --primary
        place_desktops "$INTERNAL_MONITOR" 1 2 3 4 5 6 7 8
    fi

    # Drop bspwm's default "Desktop" and other strays; their windows merge into a neighbour
    bspc query -D --names | grep -vxE '[1-8]' | while read -r d; do bspc desktop "$d" -r; done

    [ -n "$ext" ] && bspc monitor "$ext" -o 5 6 7 8 && bspc monitor "$INTERNAL_MONITOR" -o 1 2 3 4
    [ -z "$ext" ] && bspc monitor "$INTERNAL_MONITOR" -o 1 2 3 4 5 6 7 8

    # Wallpaper and bars follow the new layout
    feh --bg-fill "$PRIMARY_WALLPAPER"
    "$HOME/bin/polybar.launch.sh" &
}

# Re-run setup_monitors on hotplug (KVM switches). udevadm monitor needs no root.
watch_monitors() {
    pkill -f "udevadm monitor --udev --subsystem-match=drm"   # previous instance on bspwm restart
    stdbuf -oL udevadm monitor --udev --subsystem-match=drm | while read -r line; do
        case "$line" in *" change "*) ;; *) continue ;; esac
        # KVM switches fire bursts of events; wait until quiet for 1s
        while read -r -t 1 _; do :; done
        log "Monitor change detected"
        setup_monitors
    done &
}

configure_bspwm() {
    bspc config border_width 2
    bspc config window_gap 8
    bspc config bottom_padding 20
    bspc config top_padding 0
    bspc config split_ratio 0.5
    bspc config borderless_monocle true
    bspc config gapless_monocle false
    bspc config focus_follows_pointer false
    bspc config pointer_follows_monitor false
    # Unplugged/disabled monitors are removed; their desktops merge into a remaining one
    bspc config remove_disabled_monitors true
    bspc config remove_unplugged_monitors true
}

setup_rules() {
    bspc rule -r "*"
    bspc config external_rules_command "$(command -v bspwm-external-rules)"
}
start_apps() {
    # Start-up Applications

    # Restart critical background services
    restart_app nm-applet
    restart_app blueman-applet
    restart_app fusuma
    restart_app picom --backend glx
    restart_app redshift-gtk
    restart_app sxhkd >"$LOG_DIR/sxhkd_output.log" 2>"$LOG_DIR/sxhkd_error.log"

    # Start only if not running
    start_app syncthing --no-browser
    start_app alacritty

    # Auto-lock: after 10 min idle, and before suspend/lid-close (logind)
    xset s 600 30
    start_app xss-lock --transfer-sleep-lock -- "$HOME/bin/lock_screen"
    # start_app nitrogen --set-scaled "$PRIMARY_WALLPAPER"
}

###############################################################################
# MAIN STARTUP
###############################################################################

main() {
    mkdir -p "$LOG_DIR"
    : > "$OUTPUT_LOG"
    : > "$ERROR_LOG"
    : > "$LOG_DIR/bspwm-external-rules.log"
    rm -f "$LOG_DIR/bspwm-external-rules.debug.log"

    $DEBUG && set -x



    # BSPWM settings & monitors (also launches polybar and sets wallpaper)
    configure_bspwm
    setup_rules
    setup_monitors
    watch_monitors
    start_apps

    # Final notification
    dunstify -a "BSPWM" "INFO" "BSPWM loaded @ $(date)" -r 5552

    $DEBUG && set +x
}

main >"$OUTPUT_LOG" 2>"$ERROR_LOG"
